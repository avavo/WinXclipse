<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar card: flat surface; pressed or focused (gamepad) gets the blue-to-purple ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/wx_card_active" />
    <item android:state_focused="true" android:drawable="@drawable/wx_card_active" />
    <item android:state_selected="true" android:drawable="@drawable/wx_card_active" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wx_surface" />
            <stroke android:width="1dp" android:color="@color/wx_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
