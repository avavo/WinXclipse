<?xml version="1.0" encoding="utf-8"?>
<!-- Exit: red-tinted disc, solid red ring when active. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#40FF6B7D" />
            <stroke android:width="2dp" android:color="@color/wx_danger" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#40FF6B7D" />
            <stroke android:width="2dp" android:color="@color/wx_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#26FF6B7D" />
            <stroke android:width="1dp" android:color="#80FF6B7D" />
        </shape>
    </item>
</selector>
