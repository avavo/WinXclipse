#version 450
// Generated by tools/export_vulkan_shaders.py; edit the original algorithm.
layout(set=0,binding=0) uniform sampler2D currFrame;
layout(set=0,binding=1) uniform sampler2D prevFrame;
layout(set=0,binding=2) uniform sampler2D mvHistoryTexture;
layout(set=0,binding=3,rgba8) uniform writeonly image2D motionVectorOutput;
layout(push_constant) uniform EffectParameters {
    layout(offset=0) int quality;
};
vec4 winxTexture(sampler2D s, vec2 uv) { return texture(s,vec2(uv.x,1.0-uv.y)); }
vec4 winxTextureLod(sampler2D s, vec2 uv, float lod) { return textureLod(s,vec2(uv.x,1.0-uv.y),lod); }
vec4 winxTexelFetch(sampler2D s, ivec2 p, int lod) { return texelFetch(s,ivec2(p.x,textureSize(s,lod).y-1-p.y),lod); }

layout(local_size_x=16, local_size_y=8, local_size_z=1) in;









float luma(vec3 c){return dot(c,vec3(0.299,0.587,0.114));}
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy); ivec2 sz=imageSize(motionVectorOutput);
 if(p.x>=sz.x||p.y>=sz.y)return;
 vec2 uv=(vec2(p)+0.5)/vec2(sz), ts=1.0/vec2(sz);
 vec3 c=winxTextureLod(currFrame,uv,0.0).rgb;
 float d=distance(c,winxTextureLod(prevFrame,uv,0.0).rgb)*0.57735;
 if(d<0.008){imageStore(motionVectorOutput, ivec2(p.x, imageSize(motionVectorOutput).y - 1 - p.y),vec4(0.5,0.5,1.0,1.0));return;}
 float cut=d>0.70?1.0:0.0, best=d; vec2 mv=vec2(0.0);
 int iterations=quality==0?2:(quality==1?3:4);
 if(cut<0.5){for(int i=4;i>=1;i--){if(i>iterations)continue;
  float s=quality==0?(i==2?4.0:1.0):(quality==1?(i==3?8.0:(i==2?3.0:1.0)):(i==4?16.0:(i==3?6.0:(i==2?3.0:1.0))));
  vec2 o[4];o[0]=vec2(s,0);o[1]=vec2(-s,0);o[2]=vec2(0,s);o[3]=vec2(0,-s);
  for(int j=0;j<4;j++){vec2 candidate=mv+o[j]*ts;float sad=distance(c,winxTextureLod(prevFrame,clamp(uv+candidate,0.0,1.0),0.0).rgb)*0.57735;if(sad<best){best=sad;mv=candidate;}}}}
 vec2 old=(winxTextureLod(mvHistoryTexture,uv,0.0).rg-0.5)*0.25;
 vec2 hist=(winxTextureLod(mvHistoryTexture,clamp(uv-old,0.0,1.0),0.0).rg-0.5)*0.25;
 float conf=(1.0-cut)*(1.0-clamp(best*2.5,0.0,1.0));
 vec2 stable=mix(hist,mv,0.8)*smoothstep(0.10,0.55,conf);
 vec2 encoded=clamp(stable*4.0+0.5,0.0,1.0);
 imageStore(motionVectorOutput, ivec2(p.x, imageSize(motionVectorOutput).y - 1 - p.y),vec4(encoded,conf,1.0));}
