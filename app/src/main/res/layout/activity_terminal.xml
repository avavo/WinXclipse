<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/outputTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="?attr/winxOnSurfaceColor"
            android:background="?attr/winxPanelBackground"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:scrollbars="vertical"
            android:textIsSelectable="true" />
    </ScrollView>

    <EditText
        style="@style/EditText"
        android:id="@+id/commandInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="@string/terminal_command"
        android:inputType="text" />

    <Button
        style="@style/ButtonNeutral"
        android:id="@+id/executeButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="@string/terminal_execute" />
</LinearLayout>
