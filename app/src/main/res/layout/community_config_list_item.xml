<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:id="@+id/LLInnerArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shortcut_tile_background"
        android:clipToOutline="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/IVIcon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Community config artwork"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/FLLabelArea"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/shortcut_label_background"
            android:clipToOutline="true"
            android:padding="2dp">

            <ImageView
                android:id="@+id/IVLabelBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.92"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:scaleX="1.12"
                android:scaleY="1.12" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/TVVersionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVVersionCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#69F0AE"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/TVConfigCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="68dp"
        android:background="@drawable/community_config_count_background"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold" />

</FrameLayout>
