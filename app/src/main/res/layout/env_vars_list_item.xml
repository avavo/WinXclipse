<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:paddingTop="4dp" android:paddingBottom="4dp"
    android:gravity="center_vertical">
    <HorizontalScrollView android:id="@+id/HSVVariableName"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginEnd="8dp" android:scrollbars="none" android:fillViewport="false">
        <TextView android:id="@+id/TextView" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:singleLine="true" android:textSize="14sp"
            android:paddingTop="8dp" android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <FrameLayout android:layout_width="124dp" android:layout_height="wrap_content" android:minHeight="48dp"
        android:paddingTop="4dp" android:paddingBottom="4dp">
        <com.winlator.cmod.widget.GlassSpinner android:id="@+id/Spinner" style="@style/ComboBox" android:layout_width="match_parent"
            android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone"
            android:spinnerMode="dialog" />
        <LinearLayout android:id="@+id/LLMultiSelectArea" android:layout_width="match_parent"
            android:layout_height="40dp" android:background="?attr/winxEditTextBackground"
            android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:visibility="gone">
            <TextView android:id="@+id/TVMultiSelectValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="?attr/winxOnSurfaceColor" />
        </LinearLayout>
        <ToggleButton android:id="@+id/ToggleButton" android:layout_width="48dp" android:layout_height="26dp"
            android:layout_gravity="center" android:background="@drawable/compact_toggle_selector"
            android:backgroundTint="@null" app:backgroundTint="@null" android:visibility="gone"
            android:textOn="" android:textOff="" />
        <EditText android:id="@+id/EditText" style="@style/EditText" android:layout_width="match_parent"
            android:layout_height="40dp" android:layout_gravity="center" android:singleLine="true"
            android:visibility="gone"  />
    </FrameLayout>
    <ImageButton android:id="@+id/BTRemove" style="@style/ListMenuButton"
        android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
        android:contentDescription="@string/remove" android:src="@drawable/icon_remove" />
</LinearLayout>