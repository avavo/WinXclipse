<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <CheckBox
            android:id="@+id/CBXPerfVblank"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_vblank" />

        <CheckBox
            android:id="@+id/CBXPerfMaxImages"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_max_images" />

        <CheckBox
            android:id="@+id/CBXPerfNoTimeline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_no_timeline" />

        <CheckBox
            android:id="@+id/CBXPerfVk3d66"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_vk3d66" />

        <CheckBox
            android:id="@+id/CBXPerfVramCap"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_vram_cap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TVXPerfVramCapMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/xperf_vram_cap_mode" />

            <Spinner
                android:id="@+id/SXPerfVramCapMode"
                android:layout_width="160dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/CBXPerfPerfcache"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_perfcache" />

        <CheckBox
            android:id="@+id/CBXPerfMdiex"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_mdiex" />

        <CheckBox
            android:id="@+id/CBXPerfNramv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_nramv" />

        <CheckBox
            android:id="@+id/CBXPerfBcnSoftware"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_bcn_software" />

        <CheckBox
            android:id="@+id/CBXPerfAstcAuto"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/xperf_astc_auto" />
    </LinearLayout>
</ScrollView>
