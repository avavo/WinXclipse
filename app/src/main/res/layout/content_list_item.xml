<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/IVIcon" android:layout_width="28dp" android:layout_height="28dp"
            android:layout_marginEnd="10dp" android:scaleType="centerInside" app:tint="?attr/colorAccent" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/TVVersionName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                android:textSize="14sp" android:textColor="?attr/winxOnSurfaceColor" />
            <TextView android:id="@+id/TVVersionCode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:textSize="12sp" android:alpha="0.7" android:textColor="?attr/winxOnSurfaceColor" />
        </LinearLayout>
        <ImageButton android:id="@+id/BTMenu" style="@style/ListMenuButton"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:contentDescription="@string/settings" android:src="@drawable/icon_list_item_menu" />
        <ImageButton android:id="@+id/BTDownload" style="@style/DownloadIconButton"
            android:contentDescription="@string/download_file" android:src="@drawable/ic_download_compact" />
    </LinearLayout>
    <LinearLayout android:id="@+id/LLTransferProgress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginStart="38dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ProgressBar android:id="@+id/Progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
            android:indeterminate="false" android:max="100" android:progress="0"
            android:progressBackgroundTint="#404040" android:progressTint="?attr/colorAccent" />
        <TextView android:id="@+id/TVProgressStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:maxWidth="100dp" android:maxLines="2" android:ellipsize="end" android:textSize="11sp" />
        <Button android:id="@+id/BTDiscardDownload" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp"
            android:minWidth="48dp" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:text="@android:string/cancel" android:textAllCaps="false" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
