<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/BTClear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Clear log"
        android:padding="8dp"
        android:src="@drawable/icon_remove" />

    <ImageButton
        android:id="@+id/BTPause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Pause log"
        android:padding="8dp"
        android:src="@drawable/icon_pause" />

    <Space
        android:layout_width="24dp"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/BTShareLog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Share log"
            android:padding="8dp"
            android:src="@drawable/icon_export" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/BTDownloadLog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Save log to Downloads"
            android:padding="8dp"
            android:src="@drawable/ic_drive_storage" />
    </LinearLayout>

</LinearLayout>
