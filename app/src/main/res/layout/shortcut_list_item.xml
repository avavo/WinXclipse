<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:id="@+id/LLInnerArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shortcut_tile_background"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ImageView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/shortcuts"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shortcut_label_background"
            android:gravity="center"
            android:orientation="vertical"
            android:minHeight="58dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/TVTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="?attr/winxOnSurfaceColor"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="?attr/winxOnSurfaceColor"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/BTMenu"
        style="@style/ListMenuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="7dp"
        android:src="@drawable/icon_list_item_menu" />
</FrameLayout>
