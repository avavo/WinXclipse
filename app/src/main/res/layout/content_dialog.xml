<?xml version="1.0" encoding="utf-8"?>
<com.winlator.cmod.widget.DialogContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/LLTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/IVIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:tint="?colorAccent"
                android:layout_marginRight="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/TVTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="?colorAccent"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>

        <View style="@style/HorizontalLine" />
    </LinearLayout>

    <com.winlator.cmod.widget.GestureScrollView
        android:id="@+id/SVDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="false">
        <TextView
        android:id="@+id/TVMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    </com.winlator.cmod.widget.GestureScrollView>

    <EditText
        style="@style/EditText"
        android:id="@+id/EditText"
        android:layout_width="match_parent"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <ListView
        android:id="@+id/ListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/FrameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/CBExtraOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/extra_option"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/LLBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View style="@style/HorizontalLine" />

        <TextView
            android:id="@+id/TVBottomBarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="?colorAccent"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/LLBottomBarPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:justifyContent="flex_end"
            app:alignItems="center">

            <Button android:id="@+id/BTDisableAll" style="@style/DialogActionButton"
                android:text="@string/disable_all" android:visibility="gone" />
            <Button android:id="@+id/BTEnableAll" style="@style/DialogActionButton"
                android:text="@string/enable_all" android:visibility="gone" />
            <Button android:id="@+id/BTReset" style="@style/DialogActionButton"
                android:text="@string/reset" android:visibility="gone" />
            <Button android:id="@+id/BTCancel" style="@style/DialogActionButton"
                android:text="@string/cancel" />
            <Button android:id="@+id/BTConfirm" style="@style/DialogActionButton"
                android:text="@string/ok" />
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
</com.winlator.cmod.widget.DialogContentLayout>
