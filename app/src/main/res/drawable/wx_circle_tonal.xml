<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary round button (help): violet tint; brighter with a lilac ring when active. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#4D7B5CFF" />
            <stroke android:width="2dp" android:color="@color/wx_lilac" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#4D7B5CFF" />
            <stroke android:width="2dp" android:color="@color/wx_lilac" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/wx_tint" />
            <stroke android:width="1dp" android:color="@color/wx_tint_border" />
        </shape>
    </item>
</selector>
