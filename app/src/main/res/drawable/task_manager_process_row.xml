<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#332D6CDF" />
            <stroke android:width="0.5dp" android:color="?colorAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/winxSurfaceColor" />
            <stroke android:width="0.5dp" android:color="#303030" />
        </shape>
    </item>
</selector>
