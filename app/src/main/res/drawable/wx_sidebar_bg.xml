<?xml version="1.0" encoding="utf-8"?>
<!-- In-game sidebar: night-blue ground with a violet glow rising from the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wx_ground" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="1.0"
                android:gradientRadius="420dp"
                android:startColor="#387B5CFF"
                android:endColor="#007B5CFF" />
        </shape>
    </item>
</layer-list>
